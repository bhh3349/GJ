# sub-gateway 生产部署 .env 模板（裸 IP 云服务器全新部署用）。
#
# 用法：cp deploy/env.production.example .env  然后只填带「必改」标记的键。
#
# 键位全集与每个键的完整语义在仓库根的 .env.example（唯一键位事实源），
# 本模板不重抄说明 —— 防两个事实源漂移。配套文档：
#   deploy/docker-deploy.md §2（配置）、§5b（全新部署三必改项 + 部署后自检）。

# ---- 必改 1：MASTER_KEY ----
# 32 字节 base64。现生成、**立刻进密码管理器**；换 key = 库内全部密文作废
# （账号池凭据全在里面）。生成用镜像里的 node，不在服务器另装：
#   docker run --rm sub-gateway:local node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# 缺失或解码后不是 32 字节 → 进程拒绝启动（不降级、不自动生成）。
MASTER_KEY=

# ---- 必改 2：管理员账号 ----
# 首次启动自动引导；密码 ≥8 字符，否则**故意启动失败**（不降级）。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ---- 容器内路径与监听（compose 的 environment 段会强制覆盖 PORT_*/HOST_*/DB_PATH，
#      这里写一致即可，避免两处值不同时排查绕远）----
DB_PATH=/app/data/gateway.db
ADMIN_WEB_DIST=/app/web/dist
HOST_GATEWAY=0.0.0.0
HOST_ADMIN=0.0.0.0
PORT_GATEWAY=4100
PORT_ADMIN=4101

# ---- 裸 IP + http：会话 cookie 不加 Secure（设 true cookie 发不出去，会话挂死）----
COOKIE_SECURE=false
TRUST_PROXY=false

# ---- 必改 3（不在本文件，在 compose）：管理面只绑回环 ----
# 编辑 docker-compose.yml 的 ports，把 "${PORT_ADMIN:-4101}:4001" 改成
# "127.0.0.1:${PORT_ADMIN:-4101}:4001"，远程访问走 SSH 隧道：
#   ssh -N -L 4101:127.0.0.1:4101 root@<host>
# 这是带会话 cookie 的完整控制面，裸 IP 下开 0.0.0.0 等于把后台交给全网扫描器。
# 改完先跑 deploy/docker-deploy.md §5b 的「部署后 5 分钟可达性自检」，再放流量。
