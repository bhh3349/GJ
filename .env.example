# ============================================================
# LLM Gateway — environment template. Copy to `.env` and fill in.
# NEVER commit a real `.env`.
# ============================================================

# --- Required ---
# 32-byte AES-256-GCM master key, base64 encoded.
# Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Startup MUST abort if missing or not exactly 32 bytes after decode.
MASTER_KEY=

# --- Listeners ---
# Gateway (OpenAI-compatible, /v1/*) — public-facing.
PORT_GATEWAY=4000
HOST_GATEWAY=0.0.0.0
# Admin API + built SPA, served same-origin.
PORT_ADMIN=4001
HOST_ADMIN=127.0.0.1

# --- Storage ---
DB_PATH=./data/gateway.db
# Call-log retention in days.
LOG_RETENTION_DAYS=30

# --- Admin auth ---
# First-run bootstrap of the admin account. Used ONLY while the admin table is
# empty; afterwards these variables are ignored (remove them from `.env`).
# ADMIN_PASSWORD must be >= 8 chars, otherwise startup aborts on purpose.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Origins allowed for CSRF Origin checks and CORS. Comma separated, exact match.
# Empty = same-origin only (no cross-origin allowed).
ALLOWED_ORIGINS=
# Set true ONLY when TLS terminates in front of the admin listener.
COOKIE_SECURE=false
# Set true when behind a reverse proxy so client IP / proto come from X-Forwarded-*.
TRUST_PROXY=false
# Argon2id (or scrypt fallback) login rate limit: attempts per minute per IP.
LOGIN_RATE_LIMIT_PER_MIN=5
# Session TTL in hours, sliding renewal.
SESSION_TTL_HOURS=24
# CI machine token. DISABLED unless non-empty. Never used by browsers.
ADMIN_TOKEN=

# --- Observability (contract §12, ADR-0013) ---
# Read-only maintenance token for `/api/observability/*`. DISABLED unless non-empty.
# Scope is ONLY `GET /api/observability/*`; any other path or write method -> 403.
# Must NOT equal ADMIN_TOKEN — startup aborts if they match (that would defeat the
# whole point: the token handed to a dashboard/read-only consumer would be an admin one).
# Never returned in a response, never logged. Rotation = change here and restart.
READONLY_TOKEN=
# Retention for 60s health snapshots, in days. Snapshots are ~1440 rows/day.
HEALTH_SNAPSHOT_RETENTION_DAYS=90

# --- Built-in assistant (contract §13, ADR-0015) ---
# Client-facing model name the in-process assistant uses. It must already exist in the
# model archive and be routed to at least one upstream key, otherwise every chat call
# ends in a 503 NO_AVAILABLE_KEY terminal frame.
# Empty = assistant NOT wired: `/api/assistant/chat` answers with an explicit terminal
# frame instead of hanging, and startup logs a warning. There is deliberately no default
# value — inventing one would disguise "not configured" as "configured wrong".
# The admin REST endpoints are unaffected by this setting.
ASSISTANT_MODEL=

# --- Gateway behaviour ---
# Max attempts across keys/upstreams before giving up. Two distinct terminal results
# (contract §10): zero candidates -> 503 NO_AVAILABLE_KEY; candidates exhausted -> 502 UPSTREAM_ERROR.
MAX_ATTEMPTS=3
# Per-key concurrent in-flight request ceiling. Must be >= 1 (startup fails otherwise).
MAX_CONCURRENCY_PER_KEY=4
# Cooldown ladder on failure, in seconds, comma separated, non-negative, non-decreasing.
# Index = consecutive-failure count - 1; the last entry is the top rung.
# The first rung is 0 by design: a first failure only takes that reason's base cooldown
# (NETWORK 15s / UPSTREAM_ERROR 10s / RATE_LIMITED 60s / 401+402 30min). Keep it 0 —
# a non-zero first rung applies from the very first failure and idles a key that only
# blipped once. Equals the frozen constant; leave the line empty for the same behaviour.
# Effective cooldown is min(max(reason base, rung), MAX_COOLDOWN_MS=30min), so:
#   - lowering a rung never shortens a failure class below its base cooldown,
#   - the long AUTH_INVALID / 402 cooldown (30min) is never shortened,
#   - a rung above 30min is capped, not silently dropped.
# Startup aborts on an empty / non-numeric / negative / decreasing list.
COOLDOWN_LADDER_SECONDS=0,60,300,900,1800

# --- Logging ---
LOG_LEVEL=info
