# ============================================================
# LLM Gateway — environment template. Copy to `.env` and fill in.
# NEVER commit a real `.env`.
# ============================================================

# --- Required ---
# 32-byte AES-256-GCM master key, base64 encoded.
# Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Startup MUST abort if missing or not exactly 32 bytes after decode.
MASTER_KEY=

# --- Listeners ---
# Gateway (OpenAI-compatible, /v1/*) — public-facing.
PORT_GATEWAY=4000
HOST_GATEWAY=0.0.0.0
# Admin API + built SPA, served same-origin.
PORT_ADMIN=4001
HOST_ADMIN=127.0.0.1

# --- Storage ---
DB_PATH=./data/gateway.db
# Call-log retention in days.
LOG_RETENTION_DAYS=30

# --- Admin auth ---
# First-run bootstrap of the admin account. Used ONLY while the admin table is
# empty; afterwards these variables are ignored (remove them from `.env`).
# ADMIN_PASSWORD must be >= 8 chars, otherwise startup aborts on purpose.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Origins allowed for CSRF Origin checks and CORS. Comma separated, exact match.
# Empty = same-origin only (no cross-origin allowed).
ALLOWED_ORIGINS=
# Set true ONLY when TLS terminates in front of the admin listener.
COOKIE_SECURE=false
# Set true when behind a reverse proxy so client IP / proto come from X-Forwarded-*.
TRUST_PROXY=false
# Argon2id (or scrypt fallback) login rate limit: attempts per minute per IP.
LOGIN_RATE_LIMIT_PER_MIN=5
# Session TTL in hours, sliding renewal.
SESSION_TTL_HOURS=24
# CI machine token. DISABLED unless non-empty. Never used by browsers.
ADMIN_TOKEN=

# --- Gateway behaviour ---
# Max attempts across keys/upstreams before giving up. Two distinct terminal results
# (contract §10): zero candidates -> 503 NO_AVAILABLE_KEY; candidates exhausted -> 502 UPSTREAM_ERROR.
MAX_ATTEMPTS=3
# Per-key concurrent in-flight request ceiling. Must be >= 1 (startup fails otherwise).
MAX_CONCURRENCY_PER_KEY=4
# Cooldown ladder on failure, in seconds, comma separated, non-decreasing.
# Index = consecutive-failure count - 1; the last entry is the top rung.
# Effective cooldown is min(max(reason base, rung), MAX_COOLDOWN_MS=30min), so:
#   - lowering a rung never shortens a failure class below its base cooldown,
#   - the long AUTH_INVALID / 402 cooldown (30min) is never shortened,
#   - a rung above 30min is capped, not silently dropped.
# The default 60,300,900,1800 behaves exactly like the frozen constant. Note the
# frozen ladder's own first rung is 0 (first failure = reason base); putting a
# non-zero first entry here makes it apply from the very first failure.
# Startup aborts on an empty / non-numeric / decreasing list.
COOLDOWN_LADDER_SECONDS=60,300,900,1800

# --- Logging ---
LOG_LEVEL=info
