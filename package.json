{
  "name": "sub-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "LLM gateway: fixed upstream base URL + pooled keys, OpenAI-compatible passthrough + web admin",
  "engines": {
    "node": ">=22.0.0 <23.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "web:dev": "pnpm --filter web dev",
    "web:build": "pnpm --filter web build",
    "check:sqlite": "node scripts/g1-sqlite-check.mjs",
    "check:secrets": "tsx src/security/plaintext-scan.ts",
    "check:shutdown": "vitest run src/wiring/shutdown.spec.ts && vitest run src/server.spec.ts",
    "test:gateway": "vitest run src/gateway",
    "test:fault": "vitest run src/gateway/fault.spec.ts",
    "bench:ttfb": "tsx scripts/bench-ttfb.ts",
    "bench:assistant-ttfb": "tsx scripts/bench-assistant-ttfb.ts",
    "probe:tierflow": "tsx scripts/probe-tierflow-datapath.ts"
  },
  "dependencies": {
    "@fastify/websocket": "^11.3.3",
    "better-sqlite3": "^11.5.0",
    "fastify": "^5.1.0",
    "undici": "^7.30.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.9.0",
    "@types/ws": "^8.18.2",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "packageManager": "pnpm@10.34.6+sha512.7e1ae66a83a9143c118cc1944f37cc4f2b8acddeda4b001cfa78908f6e46e45e15292739ca6c9d026426cc757e9318cc98c5551d6a16c165097b0028ba87b4e6"
}
